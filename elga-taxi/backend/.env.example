# --- Telegram ---
# BotFather'dan olingan token. MAXFIY!
BOT_TOKEN=123456:ABC-DEF...

# --- JWT ---
# Kuchli tasodifiy qiymat qo'ying (masalan: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=30

# --- AI (ovozli buyurtma) ---
OPENAI_API_KEY=sk-...
STT_MODEL=whisper-1
PARSE_MODEL=gpt-4o-mini

# --- Xavfsizlik ---
INITDATA_MAX_AGE=86400
# Brauzerda (Telegramdan tashqari) test uchun 1 qiling. PRODUCTIONDA 0!
ALLOW_BROWSER_DEV=0

# --- Boshqa ---
DB_PATH=elga.db
CORS_ORIGINS=*
